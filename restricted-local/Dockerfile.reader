FROM node:22.23.3-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
WORKDIR /app
COPY --chown=root:root policy.mjs cache.mjs reader.mjs ./
USER 1000:1000
# The reviewed launcher must enforce --network=none, read-only root, a single
# read-only cache directory, dropped capabilities and no inherited credentials.
ENTRYPOINT ["node", "/app/reader.mjs"]
