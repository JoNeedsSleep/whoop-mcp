# Render the one placeholder from the separately approved DATABASE_HOST.
# Exactly one lowercase service label followed by .railway.internal; no wildcard.
# Do not start the service with an unrendered file or broaden to '*'.
listen_addresses = '@DATABASE_HOST@'
port = 5432
data_directory = '/var/lib/postgresql/data/pgdata'
hba_file = '/opt/whoop-postgres/pg_hba.conf'
ident_file = '/opt/whoop-postgres/pg_ident.conf'
unix_socket_directories = '/var/lib/postgresql/data/run'
unix_socket_permissions = 0700

ssl = on
ssl_min_protocol_version = 'TLSv1.2'
ssl_cert_file = '/var/lib/postgresql/data/tls/server.pem'
ssl_key_file = '/var/lib/postgresql/data/tls/server-key.pem'
password_encryption = 'scram-sha-256'

# Proposed 500 MB / 0.5 vCPU envelope; provider limits require approval.
max_connections = 20
superuser_reserved_connections = 3
shared_buffers = '64MB'
work_mem = '2MB'
maintenance_work_mem = '32MB'
max_worker_processes = 2
max_parallel_workers = 0
max_parallel_workers_per_gather = 0
statement_timeout = '15s'
lock_timeout = '3s'
idle_in_transaction_session_timeout = '15s'
authentication_timeout = '5s'
temp_file_limit = '128MB'
max_wal_size = '128MB'
min_wal_size = '80MB'
fsync = on
full_page_writes = on
synchronous_commit = on

# Suppress SQL/parameters and error detail that can contain tokens or health data.
# Infrastructure FATAL/PANIC messages remain; treat provider logs as private.
log_destination = 'stderr'
logging_collector = off
log_statement = 'none'
log_min_messages = 'fatal'
log_min_error_statement = 'panic'
log_error_verbosity = 'terse'
log_parameter_max_length = 0
log_parameter_max_length_on_error = 0
log_min_duration_statement = -1
log_min_duration_sample = -1
log_connections = off
log_disconnections = off
log_lock_waits = off
log_checkpoints = off
log_autovacuum_min_duration = -1
log_temp_files = -1
