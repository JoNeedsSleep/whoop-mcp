# Configure only when deployment is separately approved. No real secrets here.
DATABASE_URL=
ENCRYPTION_KEY=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Exact HTTPS origin, no path or trailing slash; never jojiao.com itself.
PUBLIC_BASE_URL=
PORT=8080
SESSION_SECRET=
# Required stable numeric WHOOP user ID, obtained and verified out of band.
ALLOWED_WHOOP_USER_ID=
# Exact verified client callback URLs, comma-separated. Empty disables MCP registration.
# No guessed ChatGPT/other client URLs; use the client's documented actual callback.
APPROVED_CLIENT_REDIRECT_URIS=
# Unsafe legacy transport bypasses the unfinished gateway. Leave disabled.
ENABLE_LEGACY_DIRECT_MCP=false
