{
  "name": "whoop-mcp",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": ["web"],
  "bin": { "whoop-mcp-local": "dist/local/index.js" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run build -w web",
    "start": "node dist/index.js",
    "start:local": "node dist/local/index.js",
    "bundle:local": "npm run build && node scripts/pack-mcpb.mjs",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "keywords": ["mcp", "whoop", "model-context-protocol"],
  "author": "Christian Axtmann",
  "license": "MIT",
  "description": "Multi-user MCP server exposing WHOOP fitness data to AI clients.",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "cookie-session": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "undici": "6.29.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "fast-uri": "3.1.8",
    "ip-address": "10.7.1",
    "hono": "4.13.7",
    "nanoid@^3.0.0": "3.3.18",
    "source-map-js": "1.2.2",
    "undici@^7.0.0": "7.30.1",
    "undici@^8.0.0": "8.12.2",
    "brace-expansion@^5.0.0": "5.0.12",
    "js-yaml@^4.0.0": "4.3.2",
    "postcss-selector-parser@^7.0.0": "7.1.6"
  }
}
